# ─── Supabase ────────────────────────────────────────────────────────────────
# Panel del proyecto → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (anon). Viaja al navegador: sólo puede lo que permita RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (service_role). SALTEA RLS.
# Nunca la importes desde un componente cliente ni le pongas prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ─── Mercado Pago ────────────────────────────────────────────────────────────
# Sin estas dos variables la app compila igual y el checkout online aparece
# como "pendiente de configuración". Nunca se simula un pago aprobado.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# ─── Sitio ───────────────────────────────────────────────────────────────────
# Sin barra final. Se usa para las URLs de retorno de Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Panel de demostración ───────────────────────────────────────────────────
# Para recorrer el panel en una presentación mientras Supabase todavía no está
# conectado. Con esto en `true` el login acepta cualquier email y cualquier
# contraseña, el panel carga datos de ejemplo y muestra un banner permanente
# que aclara que nada se guarda.
#
# Se apaga sola: si las variables de Supabase de arriba están completas, el
# bypass queda desactivado aunque esta siga en `true`. Para desactivarlo a
# mano, borrá la línea o poné cualquier otro valor — sólo `true` lo enciende.
#
# NO lleva prefijo NEXT_PUBLIC_: vive únicamente en el servidor.
DEMO_ADMIN_BYPASS=

# Opcional. Firma la cookie de la sesión de demostración. Sin esto se genera
# una clave al azar en cada arranque, y las sesiones abiertas dejan de valer al
# reiniciar. Conviene fijarla sólo si se despliega en más de una instancia.
DEMO_ADMIN_SECRET=
